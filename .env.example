# ============================================================
# Шаблон переменных окружения. Скопируйте в .env и заполните
# ТОЛЬКО два обязательных ключа — остальное имеет рабочие
# значения по умолчанию в коде и менять их не нужно.
# ============================================================

# --- ОБЯЗАТЕЛЬНЫЕ КЛЮЧИ -------------------------------------

# 1. Ключ ProxyAPI (нейросеть) — личный кабинет https://proxyapi.ru
PROXYAPI_API_KEY=

# 2. Токен Telegram-бота от @BotFather
TG_BOT_API_KEY=

# --- НЕОБЯЗАТЕЛЬНЫЕ ПАРАМЕТРЫ (значения по умолчанию) -------

# ProxyAPI (в боте по умолчанию используется openai/gpt-4.1-mini)
#PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1
#PROXYAPI_MODEL=openai/gpt-4.1-mini
#PROXYAPI_TIMEOUT=90
#PROXYAPI_MAX_RETRIES=2

# Telegram-бот
#TG_BOT_PARSE_MODE=HTML
#TG_POLLING_TIMEOUT=30

# Логирование (по умолчанию: INFO в консоль и в logs/app.log)
#LOG_LEVEL=INFO
#LOG_FILE=logs/app.log
#LOG_FILE=-               # отключить запись в файл (только консоль)
